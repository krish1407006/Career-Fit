# Copy to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=careerai
DB_USER=careerai
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- External AI provider (optional during development) ---
# Phase 6 resume analysis uses this same service layer
# (apps/ai/providers.py -> apps/ai/resume_analyzer.py). Never commit real keys.
# AI_PROVIDER: "openai" (OpenAI-compatible: OpenAI/Groq/OpenRouter/Ollama) or "gemini"
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
# AI_REQUIRED=True -> resume analysis fails with a clear message when the
# provider is unconfigured or unreachable, instead of using the built-in
# rule-based fallback (AI_REQUIRED=False).
AI_REQUIRED=False
