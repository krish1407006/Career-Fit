# Copy to .env and fill in real values. Never commit .env.
#
#   copy .env.example .env
#
# The defaults below are the local development setup. For a real deployment set
# DJANGO_DEBUG=False and supply every value marked "required in production".

# --- Core ------------------------------------------------------------------
# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# The app refuses to start with DEBUG off while this is still "change-me".
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma separated. Must list the real hostnames when DEBUG is off, otherwise
# Django rejects every request with "Bad Request (400)".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
DB_NAME=careerai
DB_USER=careerai
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Production HTTPS (only used when DJANGO_DEBUG=False) -------------------
# Exact origins of the deployed frontend, e.g. https://careerai.example.com.
# Leave empty in development: with DEBUG on, all origins are allowed.
# DJANGO_CORS_ALLOWED_ORIGINS=
# Set to False only when TLS terminates at a proxy that already redirects to
# HTTPS, otherwise every plain HTTP request gets a 301.
# DJANGO_SECURE_SSL=True
# How long the browser should remember to use HTTPS only (seconds).
# DJANGO_SECURE_HSTS_SECONDS=31536000

# --- External AI provider (optional during development) --------------------
# Resume analysis and the mock interview share one service layer
# (apps/ai/providers.py -> apps/ai/resume_analyzer.py, apps/ai/interview_service.py).
# Never commit real keys. With no key configured the app stays fully usable: both
# features fall back to the built-in offline analyzers and report
# source: "offline".
# AI_PROVIDER: "openai" (OpenAI-compatible: OpenAI/Groq/OpenRouter/Ollama) or "gemini"
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
# AI_REQUIRED=True -> analysis fails with a clear message when the provider is
# unconfigured or unreachable, instead of using the offline fallback
# (AI_REQUIRED=False).
AI_REQUIRED=False
